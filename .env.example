LLM_PROVIDER=codex
LLM_MODEL=gpt-5.5
LLM_API_KEY=
# Optional endpoint must implement Responses API and strict function calling.
LLM_BASE_URL=
HEADLESS=false
MAX_STEPS=30
ACTION_TIMEOUT_MS=8000
NAVIGATION_TIMEOUT_MS=20000
LLM_TIMEOUT_SECONDS=180
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_TOKENS=16384
PROFILE_DIR=.browser-profile
MAX_TEXT_CHARS=9000
MAX_ELEMENTS=70
RECENT_HISTORY=6
# conservative: confirm ambiguous controls; balanced: trust model risk + keyword checks.
SAFETY_MODE=conservative
# No mid-task prompts; blocked actions replan instead of asking for approval.
AUTONOMOUS=false
